command "issues-browser" {
    title "Issues Browser"
    summary "Forge metadata index (default) + opt-in per-repo backup — CLI, GUI, daemon, tray"
    description "Lightweight index cache by default; full issue/PR/discussion backup when enabled per repo. Browse offline; monitor via issuesd. Integrates with RepoDrive (POST /open-repo)."
    homepage "https://github.com/dev-centr/issues-browser"
    docs "https://docs.devcentr.org/issues-browser/"
    issues "https://github.com/dev-centr/issues-browser/issues"

    section "usage" {
        summary "Common commands"
        content "issues-browser --sync <repo-path>\nissues-browser --sync <repo> --backup --yes\nissues-browser --set-backup owner/name\nissues-browser --set-index-only owner/name\nissues-browser --monitor-add|--monitor-list\nissues-browser --open-repo owner/name\nissuesd --root <path>"

        example "Index sync (default)" "issues-browser --sync ./myrepo"
        example "Full backup sync" "issues-browser --sync ./myrepo --backup --yes"
        example "Enable backup for monitored repo" "issues-browser --set-backup owner/name"
        example "Progressive help" "issues-browser ?"
    }

    section "backup" {
        summary "Index vs backup"
        content "Index: <archive-root>/index/index.sqlite (stubs). Backup: archives/<host>/<owner>/<repo>/database.sqlite (bodies+comments). monitor.sdl backup true|false. Existing archives migrate to backup=true."
    }

    section "daemon" {
        summary "Continuous monitoring"
        content "issuesd polls monitor.sdl; index for all enabled repos; full backup only when backup=true. IPC 127.0.0.1:17365 (/health /status /monitor /sync-now /open-repo /monitor/set-backup)."
    }

    section "prohelp" {
        summary "Help system"
        content "help.sdl uses the OpenShellOrg ProHelp schema. Try: issues-browser ?   or   issues-browser ? backup"
    }
}
