{
	"name": "issues-browser",
	"description": "Local forge issues and discussions browser. Syncs into per-repo SQLite for offline archive and browse.",
	"authors": ["Dev-Centr"],
	"license": "MIT",
	"copyright": "Copyright © 2025–2026, Dev-Centr",
	"homepage": "https://github.com/dev-centr/issues-browser",
	"documentationURL": "https://docs.devcentr.org/issues-browser/",
	"dependencies": {
		"d2sqlite3": "~>1.0.0",
		"stdx-allocator": "~>3.0.2"
	},
	"subConfigurations": {
		"d2sqlite3": "all-included"
	},
	"configurations": [
		{
			"name": "application",
			"targetType": "executable",
			"targetName": "issues-browser-gui",
			"mainSourceFile": "source/app_gui.d",
			"dependencies": {
				"dlangui": "~>0.10.8"
			},
			"subConfigurations": {
				"dlangui": "minimal"
			},
			"versions": ["EmbedStandardResources"],
			"libs-windows": ["ole32"]
		},
		{
			"name": "cli",
			"targetType": "executable",
			"targetName": "issues-browser",
			"mainSourceFile": "source/app_cli.d",
			"subConfigurations": {
				"d2sqlite3": "all-included"
			}
		},
		{
			"name": "library",
			"targetType": "library",
			"excludedSourceFiles": ["source/app_gui.d", "source/app_cli.d"]
		}
	],
	"sourcePaths": ["source"],
	"importPaths": ["source"]
}
